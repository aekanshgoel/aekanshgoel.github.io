---
import { site } from "../config";

const path = Astro.url.pathname;
const isHome = path === "/";
const isWriting = path.startsWith("/writing/");
const isAbout = path === "/about/";

const navClass = (active: boolean) =>
  ["nav-link", active ? "is-active" : ""].filter(Boolean).join(" ");
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-label={`Home — ${site.name}`}>{site.name}</a>
    <nav aria-label="Main">
      <a
        class={navClass(isHome)}
        href="/"
        aria-current={isHome ? "page" : undefined}
      >Home</a>
      <a
        class={navClass(isWriting)}
        href="/writing/"
        aria-current={isWriting ? "page" : undefined}
      >Writing</a>
      <a
        class={navClass(isAbout)}
        href="/about/"
        aria-current={isAbout ? "page" : undefined}
      >About</a>
    </nav>
  </div>
</header>
