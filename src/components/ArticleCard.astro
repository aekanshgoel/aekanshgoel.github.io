---
import { type CollectionEntry } from "astro:content";
import { formatDate, postUrl } from "../lib/format";

interface Props {
  post: CollectionEntry<"posts">;
  /**
   * Heading level for the article title.
   * "h2" directly under a page <h1>; "h3" under a section heading.
   */
  heading?: "h2" | "h3";
}

const { post, heading = "h2" } = Astro.props;
const TitleTag = heading;
---

<article class="post-row" data-tags={JSON.stringify(post.data.tags)}>
  <TitleTag class="post-row-title">
    <a href={postUrl(post.id)}>{post.data.title}</a>
  </TitleTag>
  <p class="post-row-meta">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    {post.data.tags.length > 0 && (
      <>
        <span class="meta-dot" aria-hidden="true">·</span>
        <span class="post-row-tags">{post.data.tags.join(" · ")}</span>
      </>
    )}
  </p>
  <p class="post-row-excerpt">{post.data.description}</p>
</article>
